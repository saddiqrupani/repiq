# Copy to api/.env and adjust if your local Supabase prints different values.
# The default JWT secret is what `supabase start` uses when config.toml has not been changed.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Anon key is required for PostgREST calls the backend makes on behalf of the caller.
# Grab from `supabase status` after `supabase start`.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# For iOS simulator: leave 127.0.0.1. For a physical device, replace with your mac's LAN IP.
API_HOST=127.0.0.1
API_PORT=8000

# Coach quiz generation. Optional — endpoint returns 503 if unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
